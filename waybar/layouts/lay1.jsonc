{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "height": 32,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,

    "modules-center": ["group/pill-in"],

    "group/pill-in": {
        "orientation": "horizontal",
        "modules": [
            "clock",
            "hyprland/workspaces",
            "pulseaudio",
            "network",
            "custom/bat-icon", 
            "battery"
        ]
    },

    "clock": {
        "format": "{:%H:%M}",
        "interval": 60
    },

    "hyprland/workspaces": {
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        },
        "show-special": false,
        "active-only": false,
        "on-click": "activate"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },

    "custom/bat-icon": {
            "format": "{icon}",
            "return-type": "json",
            "exec": "echo '{\"alt\": \"'$(cat /sys/class/power_supply/BAT0/status)'\", \"percentage\": '$(cat /sys/class/power_supply/BAT0/capacity)'}'",
            "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
        },
    
        "battery": {
            "format": "{capacity}", 
        },

    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "on-click": "nm-connection-editor" 
    }
}
